## Azure Functions host 4 + .NET 10 isolated worker runtime, for linux/arm64 (for example Raspberry Pi).
## Microsoft publish this image for amd64 only, and no longer publish its Dockerfile sources,
## so this follows Microsoft's public custom-container template (MIT licensed, see THIRD-PARTY-NOTICES):
## https://github.com/Azure/azure-functions-docker/blob/dev/custom-container/template.Dockerfile

# The build workflow always passes the version to build; this default is only for local builds.
# Releases: https://github.com/Azure/azure-functions-host/releases
ARG HOST_VERSION=4.1055.100

# All stages use the same explicit distro (Ubuntu 24.04 "noble"), so the .NET runtime copied
# between stages always matches the OS it runs on, and a change to Microsoft's default distro
# can't silently change this image.
ARG DOTNET_TAG=10.0-noble

## The builder runs on the build machine's own architecture and cross-publishes
## the self-contained host for linux-arm64.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:${DOTNET_TAG} AS host-builder
ARG HOST_VERSION

# Clone the release tag, publish the host, and ship the host's licence files with its binaries.
#
# The host's NuGet.config sends every package to Microsoft's Azure DevOps mirror of nuget.org,
# which only serves anonymous users packages it has already cached. The ReadyToRun compiler
# for an arm64 build machine (Microsoft.NETCore.App.Crossgen2.linux-arm64) isn't cached there,
# so it's mapped to nuget.org instead. Every other package still comes from Microsoft's feeds.
RUN git clone --depth 1 --branch "v${HOST_VERSION}" https://github.com/Azure/azure-functions-host /src/azure-functions-host && \
    cd /src/azure-functions-host && \
    sed -i \
      -e 's|<clear />|<clear />\n    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />|' \
      -e 's|<packageSourceMapping>|<packageSourceMapping>\n    <packageSource key="nuget.org"><package pattern="Microsoft.NETCore.App.Crossgen2.*" /></packageSource>|' \
      NuGet.config && \
    grep -q 'pattern="Microsoft.NETCore.App.Crossgen2.\*"' NuGet.config && \
    dotnet restore --runtime linux-arm64 src/WebJobs.Script.WebHost/WebJobs.Script.WebHost.csproj && \
    dotnet publish -v q /p:CI=true src/WebJobs.Script.WebHost/WebJobs.Script.WebHost.csproj -c Release --output /azure-functions-host --self-contained --runtime linux-arm64 && \
    cp LICENSE.txt LICENSE_APACHE.txt /azure-functions-host/

## .NET runtime and ASP.NET Core shared framework for the isolated worker (the app is not self-contained).
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_TAG} AS dotnet-runtime

## runtime-deps is enough for the self-contained host.
FROM mcr.microsoft.com/dotnet/runtime-deps:${DOTNET_TAG}
ARG HOST_VERSION
ARG DOTNET_TAG

COPY --from=host-builder [ "/azure-functions-host", "/azure-functions-host" ]
COPY --from=dotnet-runtime [ "/usr/share/dotnet", "/usr/share/dotnet" ]

# No extension bundle: dotnet-isolated apps reference extensions as NuGet packages instead.
# `dotnet` is put on PATH with ENV rather than a symlink, so this stage has no RUN step and
# the image builds on any machine without arm64 emulation.
# ASPNETCORE_HTTP_PORTS (8080, from the base image) is cleared so it doesn't conflict with
# ASPNETCORE_URLS; the host listens on port 80, as Microsoft's Functions images do.
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    HOME=/home \
    DOTNET_USE_POLLING_FILE_WATCHER=true \
    DOTNET_ROOT=/usr/share/dotnet \
    PATH="${PATH}:/usr/share/dotnet" \
    HOST_VERSION=$HOST_VERSION \
    FUNCTIONS_WORKER_RUNTIME=dotnet-isolated \
    ASPNETCORE_HTTP_PORTS= \
    ASPNETCORE_URLS=http://+:80 \
    PORT=80

EXPOSE 80

# Standard OCI image metadata. Revision and creation time are added by the build workflow.
LABEL org.opencontainers.image.title="Azure Functions .NET 10 isolated base image (linux/arm64)" \
      org.opencontainers.image.description="Azure Functions host $HOST_VERSION with the .NET 10 isolated worker runtime for linux/arm64. Community-built; not affiliated with Microsoft." \
      org.opencontainers.image.version="$HOST_VERSION" \
      org.opencontainers.image.source="https://github.com/andrewbuckingham/azure-functions-dotnet-isolated-arm64" \
      org.opencontainers.image.base.name="mcr.microsoft.com/dotnet/runtime-deps:${DOTNET_TAG}"

# Runs as root, like Microsoft's Functions images. See the README for running as a non-root user.
CMD ["/azure-functions-host/Microsoft.Azure.WebJobs.Script.WebHost"]
